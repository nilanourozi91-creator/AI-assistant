                Free to start
              </span>

              <span className="flex items-center gap-2">
                {/* <Check size={16} className="text-emerald-500" /> */}
                No credit card
              </span>
            </div>
          </div>

          {/* AI Preview */}
          <motion.div
  animate={{
    y: [0, -8, 0],
  }}
  transition={{
    duration: 4,
    repeat: Infinity,
    ease: "easeInOut",
  }}
  className="rounded-3xl relative border border-gray-200 bg-white p-6 shadow-2xl dark:border-gray-800 dark:bg-[#161E2E]"
           >

