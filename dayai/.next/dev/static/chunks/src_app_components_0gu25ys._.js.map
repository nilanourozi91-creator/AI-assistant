"use client";

import { motion } from "motion/react";
import Navebar from "./navbar";
const fadeUp = {
  hidden: {
    opacity: 0,
    y: 40,
  },
  visible: {
    opacity: 1,
    y: 0,
    transition: {
      duration: 0.7,
      ease: "easeOut",
    },
  },
};

const staggerContainer = {
  hidden: {},
  visible: {
    transition: {
      staggerChildren: 0.12,
    },
  },
};
export default function Home() {
  return (
    <main className="min-h-screen bg-slate-50 text-slate-900 dark:bg-[#0B1020] dark:text-white">

      {/* ================= NAVBAR ================= */}
      <Navebar/>

      {/* ================= HERO ================= */}
      <section className="relative overflow-hidden">
        
        {/* Background decoration */}
        <div className="pointer-events-none absolute left-1/2 top-0 -z-10 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-purple-500/10 blur-3xl" />

