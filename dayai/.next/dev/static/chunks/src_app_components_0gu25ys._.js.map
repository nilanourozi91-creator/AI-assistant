              </div>

              {/* Chat */}
              <div className="space-y-6 p-6">

                {/* User */}
                <div className="flex justify-end">
                  <div className="max-w-[80%] rounded-2xl rounded-br-md bg-purple-600 px-4 py-3 text-sm text-white">
