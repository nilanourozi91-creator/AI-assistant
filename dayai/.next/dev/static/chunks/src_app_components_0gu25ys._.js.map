                          </p>
                        </div>

                        {/* <Clock3 */}
                          {/* size={17}
                          className="text-slate-400"
                        /> */}
                      </div>

                      <div className="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-[#161E2E]">
                        <div className="rounded-lg bg-indigo-100 p-2 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400">
                          {/* <Brain size={15} /> */}
                        </div>

                        <div className="flex-1">
                          <p className="text-xs font-semibold">
